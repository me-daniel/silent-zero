credentials*
secrets*
*.secret
*.secrets
*token*.txt
.huggingface/
hf_token*
.aws/
.azure/
.gcloud/
.config/gcloud/
*service-account*.json
*-sa-key*.json
application_default_credentials.json
.openai/
.anthropic/

